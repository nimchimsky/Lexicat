# Connexió Postgres (local per defecte amb `npm run db`; Postgres incrustat, sense Docker)
DATABASE_URL=postgres://pompeu:pompeu@localhost:5433/pompeu

# En dev, sense clau de correu, l'enllaç màgic es mostra per consola/pantalla.
# Producció: calen Resend i un remitent verificat al domini propi.
# RESEND_API_KEY=re_xxxx
# MAIL_FROM="Lexicat <joc@el-teudomini.cat>"

# Origen absolut per als enllaços del correu màgic. Darrere d'un proxy o en
# previews, l'origin de la petició pot ser el host intern: aquesta variable mana.
# APP_BASE_URL=https://lexic.cat

# Secret del cron de manteniment (/api/cron/sweep): Vercel l'envia com a
# Bearer. Sense valor, la ruta queda oberta (només acceptable en dev local).
# CRON_SECRET=genera-una-cadena-llarga

# Token d'accés a les mètriques internes (/api/metrics/funnel, capçalera
# x-admin-token). Sense valor, la ruta respon 404.
# ADMIN_TOKEN=genera-una-cadena-llarga

# URL pública del lloc (metadata, sitemap, robots, Open Graph).
# NEXT_PUBLIC_SITE_URL=https://lexic.cat

# Ruta del CSV d'origen (per defecte: ../stimulus_response_measures_23691891.csv respecte del projecte)
# ITEM_BANK_CSV=C:\ruta\al\stimulus_response_measures_23691891.csv

# Mapatge morfològic forma→lema per a `npm run db:lemmas`
# LEMMA_MAP_CSV=C:\ruta\al\mapa-forma-lema.csv
